# Get a key at https://openrouter.ai/keys  (free tier works)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — override the model fallback chain (comma separated, first = primary).
# Leave unset to use the tuned defaults in lib/models.ts
# SABAQ_MODELS_EN=deepseek/deepseek-chat-v3-0324:free,meta-llama/llama-3.3-70b-instruct:free
# SABAQ_MODELS_UR=qwen/qwen3-235b-a22b:free,deepseek/deepseek-chat-v3-0324:free

# Shown in OpenRouter rankings — optional
SITE_URL=http://localhost:3000
SITE_NAME=Sabaq AI
