# Get a key at https://openrouter.ai/keys  (free tier works)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown in OpenRouter rankings — optional
SITE_URL=http://localhost:3000
SITE_NAME=Sabaq AI

# ---------------------------------------------------------------------------
# Speed and reliability knobs. All optional; the defaults suit a free tier on a
# 60-second serverless function.
# ---------------------------------------------------------------------------

# Total wall clock for one generation, in ms. Keep it below your host's function
# limit or the platform kills the request mid-stream. Vercel Hobby = 60s.
# SABAQ_BUDGET_MS=52000

# Send the full knowledge packs (~5,300 tokens) instead of the compact ruleset
# (~1,600). Better plans, noticeably slower first token. Good for local use.
# SABAQ_FULL_CONTEXT=1

# Pin exact model ids and skip live discovery. Normally unnecessary: the app
# reads the live free-model list and ranks it by family. Run `npm run doctor`
# or open /api/doctor to get a list that actually works with your key.
# SABAQ_MODELS_EN=z-ai/glm-4.6:free,deepseek/deepseek-chat-v3.1:free
# SABAQ_MODELS_UR=qwen/qwen3-max:free,z-ai/glm-4.6:free
